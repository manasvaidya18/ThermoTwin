# Copy to .env and adjust. Real environment variables take priority over this file.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database: SQLite file by default. Set POSTGRES_DB (and the rest) to use PostgreSQL instead.
# TT_DB=backend/db.sqlite3
# POSTGRES_DB=thermotwin
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Prediction engine (FastAPI). Django calls it here; if it is not running, Django scores in-process instead.
TT_ENGINE_URL=http://127.0.0.1:8102
TT_ENGINE_PORT=8102
# TT_MODELS=prediction_engine/models/models.pkl

# Demo
TT_DEMO_PASSWORD=change-me-demo-password
TT_ESCALATE_AFTER_MIN=30
# TT_SCENARIO=backend/apps/telemetry/scenarios/pune_demo.json
# TT_FRONTEND=frontend
