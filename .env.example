# Copy to .env and adjust. Real environment variables take priority over this file.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# PostgreSQL: application data (users, organizations, facilities, units, stock, alerts, incidents).
# Leave POSTGRES_DB empty to fall back to a local SQLite file (quick tests only).
POSTGRES_DB=thermotwin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# InfluxDB 2.x: time series (sensor readings, Virtual Vial / risk / cooling-health history).
# Create an org and bucket in the InfluxDB UI (http://localhost:8086) and an API token with read/write on the bucket.
# Leave INFLUX_URL empty to keep readings in a PostgreSQL table instead.
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your-influxdb-api-token
INFLUX_ORG=thermotwin
INFLUX_BUCKET=thermotwin

# Prediction engine (FastAPI). Django calls it here; if it is not running, Django scores in-process instead.
TT_ENGINE_URL=http://127.0.0.1:8102
TT_ENGINE_PORT=8102
# TT_MODELS=prediction_engine/models/models.pkl

# Demo
TT_DEMO_PASSWORD=change-me-demo-password
TT_ESCALATE_AFTER_MIN=30
# TT_SCENARIO=backend/apps/telemetry/scenarios/pune_demo.json
# TT_FRONTEND=frontend
